# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
# All values come from the Firebase project's service account JSON file.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# ─── Admin Access ────────────────────────────────────────────────────────────
# Comma-separated list of emails with admin access (dev & internal tools).
ADMIN_EMAILS=admin@example.com,ops@example.com

# ─── Google Maps (Phase 14 — optional) ───────────────────────────────────────
# When set, GET /api/recommendations?lat=<lat>&lng=<lng>&radius=<km> will fetch
# real nearby places from the Google Maps Places API (Nearby Search) instead of
# the static Firestore catalogue.
# Required APIs: Places API (legacy) — enable at https://console.cloud.google.com/apis
# Leave blank to use Firestore data only (graceful fallback).
GOOGLE_MAPS_API_KEY=

# ─── Phase 15 — Performance (optional) ───────────────────────────────────────
# Recommendation result cache TTL (ms). Default 300000 = 5 minutes.
# RECOMMENDATION_CACHE_TTL_MS=300000
# Auto fast mode when concurrent /recommendations exceeds this count (in-process).
# RECOMMENDATION_HIGH_LOAD_CONCURRENT=8
# Force fast mode (skip embedding + model): RECOMMENDATIONS_HIGH_LOAD=true
# Places scored per setImmediate chunk for parallel scheduling.
# RECOMMENDATION_SCORE_CHUNK_SIZE=8
# Redis: not wired — use in-memory TtlCache; add ioredis + shared store for multi-instance.

# ─── Phase 17 — A/B experiment (optional) ────────────────────────────────────
# EXPERIMENT_ACTIVE=true enables variant assignment, meta.experiment, interaction stamps.
# EXPERIMENT_B_PERCENT=50
# EXPERIMENT_B_RULE_BLEND=0.6
# EXPERIMENT_B_MODEL_BLEND=0.4

# ─── Phase 18 — Production Readiness ─────────────────────────────────────────

# Logging
# NODE_ENV=production switches winston to JSON format.
# LOG_LEVEL=info        — override log level (error|warn|info|http|debug).
# LOG_FILE=true         — also write logs/error.log + logs/combined.log (creates logs/ dir).
LOG_LEVEL=info
LOG_FILE=false

# Rate limiting
# RATE_LIMIT_WINDOW_MS  — sliding window in ms. Default 900000 (15 min).
# RATE_LIMIT_GLOBAL_MAX — max requests per IP per window (global). Default 300.
# RATE_LIMIT_AUTH_MAX   — max requests per IP per 1 min (authenticated routes). Default 60.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=60

# Recommendation fallback
# RECOMMENDATION_FALLBACK_ENABLED=true — return top-N seed places instead of 500 when engine fails.
# RECOMMENDATION_FALLBACK_ENABLED=false

# ─── Phase AI — Python AI Microservice ───────────────────────────────────────
# URL of the FastAPI AI service.
#   Docker Compose (default): http://ai-service:8000
#   Local dev (no Docker):     http://localhost:8000
AI_SERVICE_URL=http://ai-service:8000

# Set to "false" to disable the AI service call (pure rule-based mode).
# Default is enabled (any value other than "false").
AI_SERVICE_ENABLED=true

# Timeout in ms for /predict calls. Requests exceeding this are cancelled
# and the backend falls back to rule-based rawScore. Default 800ms.
AI_SERVICE_TIMEOUT_MS=800

# Weight of aiScore in the final blend: finalScore = (1-w)×rawScore + w×aiScore
# Default 0.3 (30% AI, 70% rules) matching the spec.
AI_SCORE_BLEND=0.3

# Real-time AI feedback (every interaction → AI service /feedback for bandit update).
# Set to "false" to disable; the bandit will then only learn during /train batches.
# AI_FEEDBACK_ENABLED=true
# Per-call timeout for /feedback. Failures are non-fatal; the interaction is
# still saved to Firestore.
AI_FEEDBACK_TIMEOUT_MS=1500

# LLM-generated explanations on /predict ("Why we recommend this place").
# When enabled, /predict returns a one-sentence reason per place.  Disable
# to skip the LLM call entirely (template fallback still works automatically
# when OPENAI_API_KEY is empty).
# AI_EXPLAIN_ENABLED=true
# Cap the candidate count above which explanations are skipped per call
# (LLM cost and latency control).
AI_EXPLAIN_MAX_CANDIDATES=20
# Higher timeout used when explanations are requested (LLM calls take ~1-2s).
AI_PREDICT_EXPLAIN_TIMEOUT_MS=3500
