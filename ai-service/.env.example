# ─── Wuloye AI Service — Environment Variables ───────────────────────────────

# ─── Firebase Admin SDK (same project as backend) ─────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ─── OpenAI (Phase AI-5 — embeddings) ─────────────────────────────────────────
# Required for semantic similarity scoring.  Leave empty to fall back to
# type-affinity as a proxy (other model components continue to work).
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI Embeddings — budget & rate (saves tokens / avoids 429s)
# Truncate inputs before the API (characters). ~8k is safe for embedding models.
OPENAI_EMBED_MAX_CHARS=8000
# Max embedding HTTP calls per rolling 60s (each batched request = 1 call).
OPENAI_RPM_LIMIT=90
# Minimum seconds between embedding calls; 0 disables. Reduces burst traffic.
OPENAI_MIN_EMBED_INTERVAL_SEC=0.06
# Optional soft ceiling on estimated input tokens per minute (chars÷4). 0 = off.
OPENAI_TPM_SOFT_LIMIT=0
# Strings per batched embeddings.create (train path; max 2048 per OpenAI).
OPENAI_EMBED_BATCH_SIZE=96

# ─── Model storage ────────────────────────────────────────────────────────────
# Directory (relative to WORKDIR /app) where model artefacts are written.
DATA_DIR=data

# ─── Training ─────────────────────────────────────────────────────────────────
# Minimum new interactions since last train to trigger automatic retraining.
RETRAIN_THRESHOLD=20
# Minimum interactions a user needs before personalised scores are applied.
COLD_START_THRESHOLD=3

# ─── AI score blend weights ───────────────────────────────────────────────────
# Must sum to 1.0.  Defaults: bandit=0.4  sequence=0.3  embedding=0.3
BANDIT_WEIGHT=0.4
SEQUENCE_WEIGHT=0.3
EMBEDDING_WEIGHT=0.3

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Set to "*" for development.
ALLOWED_ORIGINS=*

# ─── Event Scraping ───────────────────────────────────────────────────────────
# Optional API key to protect the POST /scrape endpoint.
# Must match SCRAPER_API_KEY in the backend .env.
SCRAPER_API_KEY=

# Telegram channel to scrape (public channel username, no @).
TELEGRAM_CHANNEL=EventsEthiopia

# Optional: Telegram Bot token for richer data via Bot API.
# If omitted, the preview page scraper is used (no account needed).
TELEGRAM_BOT_TOKEN=
